datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Secret {
  // Primary key using cuid() for clean, unguessable, hyphen-free URL slugs
  id         String    @id @default(cuid())

  // Optional human-readable label (e.g., "Production Supabase Keys")
  title      String?

  // Raw secret text: nullable so it can be wiped to NULL upon destruction
  content    String?

  // Fast state check: false at creation, permanently true once burned
  isBurned   Boolean   @default(false)

  // Timestamp of burn: enables "Burned 5 minutes ago" warning cards
  burnedAt   DateTime?

  // Auto-expiration timestamp calculated at creation
  expiresAt  DateTime

  // Optional Discord webhook URL to ping creator on destruction
  webhookUrl String?

  // Record creation timestamp
  createdAt  DateTime  @default(now())
}
